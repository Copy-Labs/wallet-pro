{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "node_modules"
  ],
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    ".plasmo/index.d.ts",
    ".next/types/**/*.ts"
  ],
  "compilerOptions": {
    "plugins": [
      {
        "transform": "typescript-transform-paths",
        "afterDeclarations": true
      },
      {
        "name": "typescript-styled-plugin",
        "tags": [
          "styled",
          "css"
        ],
        "validate": true
      },
      {
        "name": "next"
      }
    ],
    "paths": {
      "~*": [
        "./src/*"
      ]
    },
    "baseUrl": "."
  }
}
